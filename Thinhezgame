-- [[ HEARTBEAT SYSTEM (optimized) ]] --
local lastHitboxSize = 0
local lastHitboxTransparency = 0

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if _G.InfHealth and hum and hum.Health < 100 then
            hum.Health = 100
        end
        if _G.InfStamina then
            char:SetAttribute("Stamina", 100)
        end
        if _G.AntiStun then
            local stunAttributes = {"Stunned", "Stun", "Disabled", "ActionBlocked"}
            for _, attr in pairs(stunAttributes) do
                if char:GetAttribute(attr) then
                    char:SetAttribute(attr, false)
                end
            end
            if hum then
                hum.PlatformStand = false
                hum.Sit = false
                if hum.WalkSpeed < 10 then hum.WalkSpeed = 16 end
            end
        end
    end

    if _G.FullBright then
        Lighting.Brightness = 2
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
    end

    -- Chỉ cập nhật hitbox khi có thay đổi và đang bật
    if _G.HitboxEnabled then
        if lastHitboxSize ~= _G.HitboxSize or lastHitboxTransparency ~= _G.HitboxTransparency then
            lastHitboxSize = _G.HitboxSize
            lastHitboxTransparency = _G.HitboxTransparency
            updateAllHitboxes()
        end
    else
        -- Nếu hitbox tắt nhưng vẫn còn dữ liệu trong hitboxPlayers thì reset
        if next(hitboxPlayers) ~= nil then
            updateAllHitboxes()
        end
    end

    -- Aimbot
    if _G.AimbotEnabled and not IsTyping and isKiller(LocalPlayer) then
        local target = getClosestSurvivor()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            if not _G.AimbotM1Only or (_G.AimbotM1Only and IsClicking) then
                local targetPos = target.Character.HumanoidRootPart.Position
                if _G.AimbotMethod == "Camera" then
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), 1 / _G.AimbotSmoothing)
                elseif _G.AimbotMethod == "Character" and char and char:FindFirstChild("HumanoidRootPart") then
                    local root = char.HumanoidRootPart
                    root.CFrame = root.CFrame:Lerp(CFrame.new(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)), 1 / _G.AimbotSmoothing)
                end
            end
        end
    end

    -- ESP highlight state update (tối ưu bằng cách chỉ duyệt khi cần)
    for i = #highlights, 1, -1 do
        local data = highlights[i]
        if data.hl and data.hl.Parent then
            if data.p then
                local killer = isKiller(data.p)
                data.hl.FillColor = killer and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 100)
                data.hl.Enabled = (killer and _G.K_ESP) or (not killer and _G.P_ESP)
            else
                if data.t == "G" then data.hl.Enabled = _G.G_ESP
                elseif data.t == "B" then data.hl.Enabled = _G.B_ESP
                elseif data.t == "D" then data.hl.Enabled = _G.D_ESP
                elseif data.t == "T" then data.hl.Enabled = _G.T_ESP
                elseif data.t == "W" then data.hl.Enabled = _G.W_ESP
                end
            end
        else
            table.remove(highlights, i)
        end
    end
end)

