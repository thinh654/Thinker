-- Hitbox functions
local function resetHitbox(hrp)
    if hrp and hrp:IsA("BasePart") then
        hrp.Size = Vector3.new(2, 2, 2)
        hrp.Transparency = 0
        hrp.CanCollide = true
    end
end

local function applyHitboxToPlayer(player)
    if not player or player == LocalPlayer then return end
    if isKiller(player) then return end
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
            hrp.Transparency = _G.HitboxTransparency
            hrp.CanCollide = false
            hitboxPlayers[hrp] = true
        end
    end
end

local function updateAllHitboxes()
    if _G.HitboxEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                if not isKiller(player) then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                        hrp.Transparency = _G.HitboxTransparency
                        hrp.CanCollide = false
                        hitboxPlayers[hrp] = true
                    end
                else
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and hitboxPlayers[hrp] then
                        resetHitbox(hrp)
                        hitboxPlayers[hrp] = nil
                    end
                end
            end
        end
    else
        for hrp, _ in pairs(hitboxPlayers) do
            resetHitbox(hrp)
        end
        hitboxPlayers = {}
    end
end

