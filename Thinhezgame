-- [[ CORE FUNCTIONS (optimized) ]] --
local function isKiller(player)
    if not player then return false end
    if player:GetAttribute("Role") == "Killer" or player:GetAttribute("IsKiller") == true then return true end
    if player:GetAttribute("Team") == "Killer" then return true end
    if player.Team and (player.Team.Name:lower():find("killer") or player.Team.Name:lower():find("slasher")) then return true end
    if player.Character then
        local charName = player.Character.Name
        for _, name in pairs(KillerList) do
            if string.find(charName, name) or string.find(player.Name, name) then return true end
        end
    end
    return false
end

local function getClosestSurvivor()
    local closestPlayer = nil
    local shortestDistance = _G.AimbotFOV
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if not isKiller(player) then
                local pos, onScreen = Camera:WorldToViewportPoint(player.Character.HumanoidRootPart.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
                    if distance < shortestDistance then
                        closestPlayer = player
                        shortestDistance = distance
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function applyESP(obj, type)
    if not obj or obj:FindFirstChild("thinhHighlight") then return end
    local hl = Instance.new("Highlight")
    hl.Name = "thinhHighlight"
    hl.Parent = obj
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    if type == "D" then hl.FillColor = Color3.fromRGB(255, 255, 255); hl.OutlineColor = Color3.fromRGB(0, 255, 255)
    elseif type == "G" then hl.FillColor = Color3.fromRGB(255, 255, 0)
    elseif type == "B" then hl.FillColor = Color3.fromRGB(0, 200, 255)
    elseif type == "T" then hl.FillColor = Color3.fromRGB(255, 165, 0)
    elseif type == "W" then hl.FillColor = Color3.fromRGB(255, 0, 255); hl.OutlineColor = Color3.fromRGB(255, 255, 255) end
    table.insert(highlights, {hl = hl, t = type, o = obj, p = Players:GetPlayerFromCharacter(obj)})
end

