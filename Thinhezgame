const TOKEN = 'TOKEN_CỦA_BẠN';
const spamMap = new Map();
const welcomeConfig = new Map();
const points = new Map();
const gameSession = new Map();
const inventory = new Map(); // userId -> { luckyPotion: number }
const verifyConfig = new Map(); // guildId -> { channelId, roleId, messageId }

// ==================== HELPER ====================
function getInventory(userId) {
  if (!inventory.has(userId)) inventory.set(userId, { luckyPotion: 0 });
  return inventory.get(userId);
}

function createGame(mode, userId) {
  const configs = {
    easy:    { winRate: 0.37, minPts: 100, maxPts: 100 },
    hard:    { winRate: 0.20, minPts: 230, maxPts: 230 },
    extreme: { winRate: 0.055, minPts: 500, maxPts: 1000 },
  };
  const cfg = configs[mode];
  const inv = getInventory(userId);
  let winRate = cfg.winRate;
  if (inv.luckyPotion > 0) {
    winRate += 0.20;
    inv.luckyPotion -= 1;
  }
  const winCard = Math.floor(Math.random() * 5);
  const isWinnable = Math.random() < winRate;
  return { winCard: isWinnable ? winCard : -1, isWinnable, cfg };
}

function generateMathProblem() {
  const types = ['quadratic', 'log', 'trig', 'derivative'];
  const type = types[Math.floor(Math.random() * types.length)];
  let question, answer;

  if (type === 'quadratic') {
    const a = Math.floor(Math.random() * 3) + 1;
    const b = Math.floor(Math.random() * 10) - 5;
    const c = Math.floor(Math.random() * 6) - 3;
    const delta = b * b - 4 * a * c;
    if (delta < 0) return generateMathProblem();
    const x1 = ((-b + Math.sqrt(delta)) / (2 * a)).toFixed(2);
    const x2 = ((-b - Math.sqrt(delta)) / (2 * a)).toFixed(2);
    question = `Giải phương trình: **${a}x² + ${b}x + ${c} = 0**`;
    answer = x1 === x2 ? `x = ${x1}` : `x₁ = ${x1}, x₂ = ${x2}`;
  } else if (type === 'log') {
    const base = [2, 3, 5, 10][Math.floor(Math.random() * 4)];
    const result = Math.floor(Math.random() * 4) + 1;
    const val = Math.pow(base, result);
    question = `Tính: **log₍${base}₎(${val})**`;
    answer = `${result}`;
  } else if (type === 'trig') {
    const angles = [
      { deg: 0,   sin: '0',        cos: '1',        tan: '0' },
      { deg: 30,  sin: '1/2',      cos: '√3/2',     tan: '√3/3' },
      { deg: 45,  sin: '√2/2',     cos: '√2/2',     tan: '1' },
      { deg: 60,  sin: '√3/2',     cos: '1/2',      tan: '√3' },
      { deg: 90,  sin: '1',        cos: '0',        tan: 'không xác định' },
    ];
    const angle = angles[Math.floor(Math.random() * angles.length)];
    const funcs = ['sin', 'cos', 'tan'];
    const fn = funcs[Math.floor(Math.random() * funcs.length)];
    question = `Tính: **${fn}(${angle.deg}°)**`;
    answer = fn === 'sin' ? angle.sin : fn === 'cos' ? angle.cos : angle.tan;
  } else {
    const exprs = [
      { q: '**f(x) = x³ + 2x²**', a: "f'(x) = 3x² + 4x" },
      { q: '**f(x) = sin(x)**',    a: "f'(x) = cos(x)" },
      { q: '**f(x) = eˣ**',       a: "f'(x) = eˣ" },
      { q: '**f(x) = ln(x)**',    a: "f'(x) = 1/x" },
      { q: '**f(x) = x⁴ - 3x**', a: "f'(x) = 4x³ - 3" },
    ];
    const expr = exprs[Math.floor(Math.random() * exprs.length)];
    question = `Tính đạo hàm: ${expr.q}`;
    answer = expr.a;
  }
  return { question, answer };
}

// ==================== READY ====================
client.once('clientReady', () => {
  console.log('Bot online!');
  schedule.scheduleJob('0 6 * * *', async () => {
    client.guilds.cache.forEach(async (guild) => {
      const channel = guild.channels.cache.find(
        c => c.isTextBased() && c.permissionsFor(guild.members.me).has(PermissionsBitField.Flags.SendMessages)
      );
      if (channel) {
        const embed = new EmbedBuilder()
          .setTitle('☀️ Chào buổi sáng!')
          .setDescription('Chúc mọi người một ngày tốt lành! 🌟')
          .setColor(0xffd700)
          .setTimestamp();
        await channel.send({ embeds: [embed] });
      }
    });
  });
});

// ==================== WELCOME ====================
client.on('guildMemberAdd', async (member) => {
  const config = welcomeConfig.get(member.guild.id);
  const channelId = config?.channelId;
  const welcomeMsg = config?.message || `Chào <@${member.id}> mong bạn có đem theo pizza 🍕`;
  const channel = channelId
    ? member.guild.channels.cache.get(channelId)
    : member.guild.channels.cache.find(c => c.isTextBased());
  if (!channel) return;
  const embed = new EmbedBuilder()
    .setTitle('🎉 Thành viên mới!')
    .setDescription(welcomeMsg)
    .setThumbnail(member.user.displayAvatarURL({ size: 512 }))
    .setColor(0x00ffcc)
    .setTimestamp()
    .setFooter({ text: `${member.guild.name} • ${member.guild.memberCount} thành viên` });
  await channel.send({ embeds: [embed] });
});

// ==================== MESSAGES ====================
client.on('messageCreate', async (message) => {
  if (message.author.bot) return;
  if (!message.content) return;

  const msg = message.content.toLowerCase().trim();
  const args = message.content.trim().split(/\s+/);
  const userId = message.author.id;

  // Chống spam
  const words = msg.split(/\s+/);
  const wordCount = {};
  let isSpam = false;
  for (const word of words) {
    wordCount[word] = (wordCount[word] || 0) + 1;
    if (wordCount[word] >= 10) { isSpam = true; break; }
  }
  if (isSpam) {
    const data = spamMap.get(userId) || { violations: 0 };
    data.violations += 1;
    spamMap.set(userId, data);
    await message.delete().catch(() => {});
    if (data.violations <= 2) {
      await message.member.timeout(5 * 60 * 1000, 'Spam');
      const embed = new EmbedBuilder()
        .setTitle('⚠️ Cảnh báo Spam')
        .setDescription(`<@${userId}> bị cấm chat **5 phút**! (Vi phạm ${data.violations}/2)`)
        .setColor(0xff8800);
      await message.channel.send({ embeds: [embed] });
    } else {
      const embed = new EmbedBuilder()
        .setTitle('🔨 BAN')
        .setDescription(`<@${userId}> bị **BAN** vì spam quá nhiều!`)
        .setColor(0xff0000);
      await message.channel.send({ embeds: [embed] });
      await message.member.ban({ reason: 'Spam' }).catch(() => {});
      spamMap.delete(userId);
    }
    return;
  }

  // Chào
  if (msg === 'hi' || msg === 'hello' || msg === 'chào') {
    const embed = new EmbedBuilder()
      .setTitle('👋 Xin chào!')
      .setDescription(`Chào **${message.author.username}**! Bạn là ai vậy? 🤔`)
      .setColor(0x00ffcc)
      .setThumbnail(message.author.displayAvatarURL());
    await message.reply({ embeds: [embed] });
    return;
  }

  // Helpme
  if (msg === '?helpme') {
    const embed = new EmbedBuilder()
      .setTitle('🙏 Bạn cần gì?')
      .setDescription('Mình có thể giúp gì cho bạn?')
      .setColor(0x7289da);
    await message.reply({ embeds: [embed] });
    return;
  }

  // Xin tiền
  if (msg.includes('5 tỷ') || msg.includes('cho t tiền') || msg.includes('cho mình tiền')) {
    const embed = new EmbedBuilder()
      .setTitle('💀 Ôi trời!')
      .setDescription('Phải có làm thì mới có ăn!\nCòn cái loại không làm như m thì **đi bốc xít đi!** 😂')
      .setColor(0xff0000);
    await message.reply({ embeds: [embed] });
    return;
  }

  // Role
  if (msg === '?roleme') {
    const roles = message.member.roles.cache
      .filter(r => r.name !== '@everyone')
      .sort((a, b) => b.position - a.position);
    const topRole = roles.first();
    const embed = new EmbedBuilder()
      .setTitle('👑 Role của bạn')
      .setDescription(topRole ? `Role cao nhất: **${topRole.name}**` : '😅 Bạn chưa có role!')
      .setColor(topRole ? topRole.color : 0x99aab5);
    await message.reply({ embeds: [embed] });
    return;
  }

  // Thống kê
  if (msg === '?statistics') {
    const guild = message.guild;
    const embed = new EmbedBuilder()
      .setTitle(`📊 Thống kê: ${guild.name}`)
      .setThumbnail(guild.iconURL())
      .addFields(
        { name: '👥 Tổng thành viên', value: `${guild.memberCount}`, inline: true },
        { name: '🟢 Online', value: `${guild.members.cache.filter(m => m.presence?.status === 'online' || m.presence?.status === 'idle' || m.presence?.status === 'dnd').size}`, inline: true },
        { name: '🤖 Bot', value: `${guild.members.cache.filter(m => m.user.bot).size}`, inline: true },
        { name: '💬 Kênh text', value: `${guild.channels.cache.filter(c => c.type === 0).size}`, inline: true },
        { name: '🔊 Kênh voice', value: `${guild.channels.cache.filter(c => c.type === 2).size}`, inline: true },
        { name: '💎 Boost', value: `${guild.premiumSubscriptionCount}`, inline: true },
      )
      .setColor(0x00ffcc)
      .setTimestamp()
      .setFooter({ text: `Tạo ngày ${guild.createdAt.toLocaleDateString('vi-VN')}` });
    await message.reply({ embeds: [embed] });
    return;
  }

  // Avatar
  if (msg.startsWith('?avatar')) {
    const target = message.mentions.users.first() || message.author;
    const embed = new EmbedBuilder()
      .setTitle(`🖼️ Avatar của ${target.username}`)
      .setImage(target.displayAvatarURL({ size: 1024, extension: 'png' }))
      .setColor(0x00ffcc);
    await message.reply({ embeds: [embed] });
    return;
  }

  // Setup welcome
  if (msg.startsWith('?setwelcome')) {
    if (!message.member.permissions.has(PermissionsBitField.Flags.Administrator)) {
      await message.reply('❌ Cần quyền **Admin**!');
      return;
    }
    const channel = message.mentions.channels.first();
    if (!channel) {
      await message.reply('❌ Dùng: `?setwelcome #channel nội dung`');
      return;
    }
    const welcomeMsg = args.slice(2).join(' ') || 'Chào {user} mong bạn mang theo pizza 🍕';
    welcomeConfig.set(message.guild.id, { channelId: channel.id, message: welcomeMsg });
    await message.reply(`✅ Setup welcome tại ${channel}!`);
    return;
  }

  // Setup verification
  if (msg.startsWith('?setverify')) {
    if (!message.member.permissions.has(PermissionsBitField.Flags.Administrator)) {
      await message.reply('❌ Cần quyền **Admin**!');
      return;
    }
    const channel = message.mentions.channels.first();
    const role = message.mentions.roles.first();
    if (!channel || !role) {
      await message.reply('❌ Dùng: `?setverify #channel @role`');
      return;
    }

    const embed = new EmbedBuilder()
      .setTitle('✅ Xác minh thành viên')
      .setDescription('Nhấn nút bên dưới để xác minh và nhận role **' + role.name + '**!')
      .setColor(0x00ff00)
      .setFooter({ text: 'Chỉ cần nhấn 1 lần!' });

    const row = new ActionRowBuilder().addComponents(
      new ButtonBuilder()
        .setCustomId(`verify_${role.id}`)
        .setLabel('✅ Xác minh ngay!')
        .setStyle(ButtonStyle.Success)
    );

    await channel.send({ embeds: [embed], components: [row] });
    await message.reply(`✅ Đã tạo verification tại ${channel}!`);
    return;
  }

  // Xem điểm
  if (msg === '?points') {
    const pt = points.get(userId) || 0;
    const inv = getInventory(userId);
    const embed = new EmbedBuilder()
      .setTitle('💰 Thông tin tài khoản')
      .setThumbnail(message.author.displayAvatarURL())
      .addFields(
        { name: '💎 Points', value: `${pt} pts`, inline: true },
        { name: '🧪 Bình thuốc may mắn', value: `${inv.luckyPotion}`, inline: true },
      )
      .setColor(0xffd700);
    await message.reply({ embeds: [embed] });
    return;
  }

  // Đổi thưởng
  if (msg.startsWith('?redeem')) {
    const item = args[1];
    const pt = points.get(userId) || 0;

    if (!item) {
      const embed = new EmbedBuilder()
        .setTitle('🎁 Đổi thưởng')
        .addFields(
          { name: '👑 Thần may mắn', value: '1500 pts → Role Thần May Mắn', inline: false },
          { name: '🧪 Bình thuốc may mắn', value: '180 pts → +20% tỷ lệ thắng (1 lần)', inline: false },
        )
        .setDescription('Dùng: `?redeem lucky_role` hoặc `?redeem potion`')
        .setColor(0xffd700);
      await message.reply({ embeds: [embed] });
      return;
    }

    if (item === 'lucky_role') {
      if (pt < 1500) {
        await message.reply(`❌ Không đủ điểm! Cần **1500 pts**, bạn có **${pt} pts**`);
        return;
      }
      const role = message.guild.roles.cache.find(r => r.name === 'Thần May Mắn');
      if (!role) {
        await message.reply('❌ Role **Thần May Mắn** chưa được tạo trong server! Admin cần tạo role này trước!');
        return;
      }
      await message.member.roles.add(role);
      points.set(userId, pt - 1500);
      const embed = new EmbedBuilder()
        .setTitle('🎊 Đổi thưởng thành công!')
        .setDescription(`Bạn đã nhận được role **Thần May Mắn**! 👑\nCòn lại: **${pt - 1500} pts**`)
        .setColor(0xffd700);
      await message.reply({ embeds: [embed] });
      return;
    }

    if (item === 'potion') {
      if (pt < 180) {
        await message.reply(`❌ Không đủ điểm! Cần **180 pts**, bạn có **${pt} pts**`);
        return;
      }
      points.set(userId, pt - 180);
      const inv = getInventory(userId);
      inv.luckyPotion += 1;
      const embed = new EmbedBuilder()
        .setTitle('🧪 Đổi thưởng thành công!')
        .setDescription(`Bạn đã nhận được **1 Bình Thuốc May Mắn**! (+20% thắng lần sau)\nCòn lại: **${pt - 180} pts**`)
        .setColor(0x00ff99);
      await message.reply({ embeds: [embed] });
      return;
    }

    await message.reply('❌ Item không hợp lệ! Dùng `?redeem` để xem danh sách!');
    return;
  }

  // Toán cấp 3
  if (msg === '?math') {
    const { question, answer } = generateMathProblem();
    const embed = new EmbedBuilder()
      .setTitle('📐 Giải Toán Cấp 3')
      .setDescription(question + '\n\n*Trả lời bằng cách nhắn đáp án trong 30 giây!*')
      .setColor(0x3498db)
      .setFooter({ text: 'Gợi ý: Nhắn đáp án chính xác để nhận 50 pts!' });
    await message.reply({ embeds: [embed] });

    const filter = m => m.author.id === userId;
    const collector = message.channel.createMessageCollector({ filter, time: 30000, max: 1 });

    collector.on('collect', async m => {
      const userAnswer = m.content.trim().toLowerCase().replace(/\s/g, '');
      const correctAnswer = answer.toLowerCase().replace(/\s/g, '');
      if (userAnswer === correctAnswer) {
        const current = points.get(userId) || 0;
        points.set(userId, current + 50);
        const embed = new EmbedBuilder()
          .setTitle('✅ Đúng rồi!')
          .setDescription(`Đáp án: **${answer}**\n🎉 Bạn nhận được **+50 pts**!`)
          .setColor(0x00ff00);
        await m.reply({ embeds: [embed] });
      } else {
        const embed = new EmbedBuilder()
          .setTitle('❌ Sai rồi!')
          .setDescription(`Đáp án đúng là: **${answer}**`)
          .setColor(0xff0000);
        await m.reply({ embeds: [embed] });
      }
    });

    collector.on('end', (collected) => {
      if (collected.size === 0) {
        const embed = new EmbedBuilder()
          .setTitle('⏰ Hết giờ!')
          .setDescription(`Đáp án đúng là: **${answer}**`)
          .setColor(0xff8800);
        message.channel.send({ embeds: [embed] });
      }
    });
    return;
  }

  // Mini game
  if (msg.startsWith('?game')) {
    const mode = args[1]?.toLowerCase();
    if (!['easy', 'hard', 'extreme'].includes(mode)) {
      const embed = new EmbedBuilder()
        .setTitle('🎮 Mini Game - Lá Bài May Mắn')
        .addFields(
          { name: '😊 Easy', value: '`?game easy` - 35-40% thắng, +100 pts', inline: false },
          { name: '😤 Hard', value: '`?game hard` - 15-25% thắng, +230 pts', inline: false },
          { name: '💀 Extreme', value: '`?game extreme` - 5-6% thắng, +500-1000 pts', inline: false },
        )
        .setColor(0x9b59b6);
      await message.reply({ embeds: [embed] });
      return;
    }

    const game = createGame(mode, userId);
    gameSession.set(userId, { mode, game });
    const inv = getInventory(userId);

    const modeNames = { easy: '😊 Dễ', hard: '😤 Khó', extreme: '💀 Cực Khó' };
    const modeColors = { easy: 0x00ff00, hard: 0xff8800, extreme: 0xff0000 };

    const row = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId(`card_0_${userId}`).setLabel('🃏 Lá 1').setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId(`card_1_${userId}`).setLabel('🃏 Lá 2').setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId(`card_2_${userId}`).setLabel('🃏 Lá 3').setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId(`card_3_${userId}`).setLabel('🃏 Lá 4').setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId(`card_4_${userId}`).setLabel('🃏 Lá 5').setStyle(ButtonStyle.Primary),
    );

    const embed = new EmbedBuilder()
      .setTitle(`🎮 Mini Game - ${modeNames[mode]}`)
      .setDescription('Chọn **1 trong 5 lá bài**!\nMột lá bài ẩn chứa phần thưởng! 🤞')
      .addFields(
        { name: '💰 Điểm hiện tại', value: `${points.get(userId) || 0} pts`, inline: true },
        { name: '🧪 Bình thuốc', value: `${inv.luckyPotion} cái`, inline: true },
      )
      .setColor(modeColors[mode])
      .setFooter({ text: inv.luckyPotion > 0 ? '🧪 Bình thuốc may mắn đang được dùng! (+20%)' : 'Dùng ?redeem potion để tăng tỷ lệ thắng!' });

    await message.reply({ embeds: [embed], components: [row] });
    return;
  }

  // Phát nhạc
  if (msg.startsWith('?play')) {
    const voiceChannel = message.member.voice.channel;
    if (!voiceChannel) {
      await message.reply('Vào voice channel trước! 🔊');
      return;
    }
    const query = args.slice(1).join(' ');
    if (!query) {
      await message.reply('❌ Dùng: `?play tên bài hát`');
      return;
    }
    await message.reply(`🔍 Đang tìm: **${query}**...`);
    try {
      const result = await yts(query);
      const video = result.videos[0];
      if (!video) {
        await message.channel.send('❌ Không tìm thấy!');
        return;
      }
      const connection = joinVoiceChannel({
        channelId: voiceChannel.id,
        guildId: message.guild.id,
        adapterCreator: message.guild.voiceAdapterCreator,
      });
      const stream = ytdl(video.url, { filter: 'audioonly', quality: 'lowestaudio', highWaterMark: 1 << 25 });
      const resource = createAudioResource(stream);
      const player = createAudioPlayer();
      player.play(resource);
      connection.subscribe(player);
      const embed = new EmbedBuilder()
        .setTitle('🎵 Đang phát nhạc')
        .setDescription(`**${video.title}**`)
        .setThumbnail(video.thumbnail)
        .addFields(
          { name: '⏱️ Thời lượng', value: video.duration.timestamp, inline: true },
          { name: '👁️ Lượt xem', value: video.views.toLocaleString(), inline: true },
        )
        .setColor(0xff0000)
        .setURL(video.url);
      await message.channel.send({ embeds: [embed] });
      player.on(AudioPlayerStatus.Idle, () => connection.destroy());
    } catch (err) {
      console.error(err);
      await message.channel.send('❌ Lỗi phát nhạc!');
    }
    return;
  }

  // Dừng nhạc
  if (msg === '?stop') {
    const voiceChannel = message.member.voice.channel;
    if (!voiceChannel) {
      await message.reply('Bạn không ở trong voice channel!');
      return;
    }
    const connection = joinVoiceChannel({
      channelId: voiceChannel.id,
      guildId: message.guild.id,
      adapterCreator: message.guild.voiceAdapterCreator,
    });
    connection.destroy();
    await message.reply('⏹️ Đã dừng nhạc!');
    return;
  }

  // Mèo béo TTS
  if (msg.includes('mèo béo')) {
    const voiceChannel = message.member.voice.channel;
    if (!voiceChannel) {
      await message.reply('Vào voice channel trước! 🔊');
      return;
    }
    const connection = joinVoiceChannel({
      channelId: voiceChannel.id,
      guildId: message.guild.id,
      adapterCreator: message.guild.voiceAdapterCreator,
    });
    const filePath = path.join(__dirname, 'tts.mp3');
    gtts.save(filePath, 'Tao không béo!', () => {
      const player = createAudioPlayer();
      const resource = createAudioResource(filePath);
      player.play(resource);
      connection.subscribe(player);
    });
    return;
  }

  // Menu
  if (msg === '?menu') {
    const row = new ActionRowBuilder().addComponents(
      new ButtonBuilder().setCustomId('noi_chuyen').setLabel('💬 Nói chuyện').setStyle(ButtonStyle.Primary),
      new ButtonBuilder().setCustomId('tro_giup').setLabel('📖 Trợ giúp').setStyle(ButtonStyle.Success),
    );
    const embed = new EmbedBuilder()
      .setTitle('📋 Menu chính')
      .setDescription('Chọn một tùy chọn bên dưới!')
      .setColor(0x7289da);
    await message.reply({ embeds: [embed], components: [row] });
    return;
  }
});

// ==================== INTERACTIONS ====================
client.on('interactionCreate', async (interaction) => {
  if (!interaction.isButton()) return;

  // Verify
  if (interaction.customId.startsWith('verify_')) {
    const roleId = interaction.customId.split('_')[1];
    const role = interaction.guild.roles.cache.get(roleId);
    if (!role) {
      await interaction.reply({ content: '❌ Role không tồn tại!', ephemeral: true });
      return;
    }
    if (interaction.member.roles.cache.has(roleId)) {
      await interaction.reply({ content: '✅ Bạn đã được xác minh rồi!', ephemeral: true });
      return;
    }
    await interaction.member.roles.add(role);
    await interaction.reply({ content: `✅ Xác minh thành công! Bạn đã nhận được role **${role.name}**!`, ephemeral: true });
    return;
  }

  // Menu
  if (interaction.customId === 'noi_chuyen') {
    await interaction.reply({ content: '💬 Bạn muốn nói gì? Cứ nhắn thoải mái!', ephemeral: true });
    return;
  }

  if (interaction.customId === 'tro_giup') {
    const embed = new EmbedBuilder()
      .setTitle('📖 Danh sách lệnh')
      .addFields(
        { name: '💬 Chat', value: '`hi` `?helpme` `?menu`', inline: false },
        { name: '👤 Thông tin', value: '`?roleme` `?avatar` `?statistics` `?points`', inline: false },
        { name: '🎮 Game', value: '`?game easy/hard/extreme` `?math`', inline: false },
        { name: '🎁 Đổi thưởng', value: '`?redeem lucky_role` `?redeem potion`', inline: false },
        { name: '🎵 Nhạc', value: '`?play tên bài` `?stop`', inline: false },
        { name: '⚙️ Admin', value: '`?setwelcome` `?setverify`', inline: false },
      )
      .setColor(0x7289da);
    await interaction.reply({ embeds: [embed], ephemeral: true });
    return;
  }

  // Game cards
  if (interaction.customId.startsWith('card_')) {
    const parts = interaction.customId.split('_');
    const cardIndex = parseInt(parts[1]);
    const ownerId = parts[2];

    if (interaction.user.id !== ownerId) {
      await interaction.reply({ content: '❌ Đây không phải game của bạn!', ephemeral: true });
      return;
    }

    const session = gameSession.get(ownerId);
    if (!session) {
      await interaction.reply({ content: '❌ Game đã kết thúc!', ephemeral: true });
      return;
    }

    gameSession.delete(ownerId);
    const { game } = session;
    const isWin = game.isWinnable && cardIndex === game.winCard;

    let earnedPts = 0;
    if (isWin) {
      earnedPts = Math.floor(Math.random() * (game.cfg.maxPts - game.cfg.minPts + 1) + game.cfg.minPts);
      const current = points.get(ownerId) || 0;
      points.set(ownerId, current + earnedPts);
    }

    const cards = ['🃏', '🃏', '🃏', '🃏', '🃏'];
    cards[cardIndex] = isWin ? '✅' : '❌';
    if (!isWin && game.isWinnable) cards[game.winCard] = '💰';

    const embed = new EmbedBuilder()
      .setTitle(isWin ? '🎉 THẮNG!' : '💀 THUA!')
      .setDescription(
        `Bạn chọn: **Lá ${cardIndex + 1}** ${cards[cardIndex]}\n\n` +
        `${cards.join('  ')}\n\n` +
        (isWin
          ? `🎊 Bạn nhận được **+${earnedPts} points**!`
          : `😢 Lá may mắn là **Lá ${game.isWinnable ? game.winCard + 1 : 'không có lần này'}**`)
      )
      .setColor(isWin ? 0x00ff00 : 0xff0000)
      .setFooter({ text: `Tổng điểm: ${points.get(ownerId) || 0} pts` });

    await interaction.update({ embeds: [embed], components: [] });
  }
});

